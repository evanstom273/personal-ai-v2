{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": "vite",
	"buildCommand": "npm run build",
	"outputDirectory": "dist",
	"installCommand": "npm ci",
	"ignoreCommand": "bash scripts/vercel-ignore-build.sh",
	"rewrites": [
		{ "handle": "filesystem" },
		{ "source": "/(.*)", "destination": "/index.html" }
	],
	"github": {
		"autoAlias": true
	}
}
